{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the test configuration"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Name of the test suite"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the test suite"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["typescript", "python", "javascript", "shell"]
      },
      "description": "Supported programming languages for tests"
    },
    "test_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["unit", "integration", "e2e", "performance", "security"]
      },
      "description": "Types of tests supported in this configuration"
    },
    "global_config": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["development", "staging", "production", "test"]
        },
        "timeout": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600,
          "description": "Global timeout in seconds"
        },
        "required_services": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "language"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "description": "Unique UUID for the test case"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {"type": "string"},
          "type": {
            "type": "string",
            "enum": ["unit", "integration", "e2e", "performance", "security"]
          },
          "language": {
            "type": "string",
            "enum": ["typescript", "python", "javascript", "shell"]
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"}
          },
          "skip": {"type": "boolean"},
          "only": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "name", "test_cases"],
  "additionalProperties": false
}